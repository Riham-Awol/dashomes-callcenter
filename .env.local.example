# ─── Supabase connection ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your project's values.
# Find them in the Supabase dashboard → Project Settings → API.
#
# Until BOTH are set to real values, the app runs in local-only mode
# (data is kept in the browser's localStorage and never leaves the device).
# See src/lib/supabase.ts → isSupabaseConfigured().

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
